# Copy to .env and fill in values

# data.go.kr 공용 인증키 (마이페이지 → 오픈API → 개발계정)
DATA_GO_KR_API_KEY=

# API Endpoints (변경 불필요)
WEATHER_API_BASE=https://apis.data.go.kr/1360000/VilageFcstInfoService_2.0
WELFARE_API_BASE=https://apis.data.go.kr/B554287/NationalWelfareInformationsV001

# 온통청년 (youthcenter.go.kr에서 발급)
YOUTH_API_KEY=
YOUTH_API_BASE=https://www.youthcenter.go.kr/go/ythip

# YouTube Data API v3 (Google Cloud Console — 무료 quota 10,000/day)
YOUTUBE_API_KEY=

# Cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# GA4
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
GA4_STREAM_ID=

# AdSense (심사 통과 후 채움) - ca-pub-XXX
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# KakaoAdFit 300x250 광고 단위 - DAN-XXX
NEXT_PUBLIC_KAKAO_ADFIT_UNIT_300x250=

# 사이트 검증 (SEO 등록 시)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Naver: 여러 도메인 각각 다른 코드 필요 → 콤마 구분
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=
