{
  "name": "dart-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Korean corporate financial + distress score API (RapidAPI + api.market + brand landing)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "d1:apply:local": "wrangler d1 migrations apply dart-db --local",
    "d1:apply:remote": "wrangler d1 migrations apply dart-db --remote",
    "probe": "node --env-file=.env scripts/probe-opendart.mjs",
    "bootstrap:corp": "node --env-file=.env scripts/bootstrap-corp-codes.mjs",
    "bootstrap:corp:remote": "node --env-file=.env scripts/bootstrap-corp-codes.mjs --remote"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260918.1",
    "typescript": "^5.7.0",
    "wrangler": "^4.131.0"
  }
}
